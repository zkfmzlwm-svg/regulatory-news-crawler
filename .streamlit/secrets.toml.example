# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요.
# secrets.toml 은 .gitignore 에 포함되어 있어 절대 GitHub에 올라가지 않습니다.
#
# Streamlit Community Cloud에 배포할 때는 이 값들을 로컬 파일 대신
# 앱 설정(Settings → Secrets)에 그대로 붙여넣으면 됩니다.

# AI 요약(토큰 사용) 기능에 필요. 없으면 단순 요약만 동작합니다.
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxx"

# 이 앱에 접속할 때 요구할 비밀번호. 설정하지 않으면 비밀번호 없이 누구나 접속 가능합니다.
# 다른 사람과 공유하는 배포판에는 반드시 설정하는 것을 권장합니다.
APP_PASSWORD = "원하는비밀번호"
